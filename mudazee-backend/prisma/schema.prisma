// MUDAZEE — Prisma schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum GenderCategory {
  MEN
  WOMEN
  UNISEX
}

enum Season {
  SUMMER
  WINTER
  SPRING
  FALL
  ALL_SEASON
}

enum FragranceType {
  TESTER
  FULL_BOTTLE
  CUSTOM_BOX
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  STRIPE
  JAZZCASH
  EASYPAISA
  PAYFAST
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum VoucherType {
  PERCENT
  FIXED
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role           @default(CUSTOMER)
  refreshTokens RefreshToken[]
  orders        Order[]
  carts         Cart[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  sku            String            @unique
  description    String
  originalPrice  Decimal           @db.Decimal(10, 2)
  salePrice      Decimal?          @db.Decimal(10, 2)
  stockQuantity  Int               @default(0)
  images         String[]
  ratingAvg      Decimal           @default(0) @db.Decimal(2, 1)
  reviewCount    Int               @default(0)
  isSoldOut      Boolean           @default(false)
  isNewArrival   Boolean           @default(false)
  isBestSeller   Boolean           @default(false)
  isActive       Boolean           @default(true)

  // Perfume-specific attributes
  impressionOf   String?
  genderCategory GenderCategory    @default(UNISEX)
  season         Season            @default(ALL_SEASON)
  fragranceType  FragranceType     @default(FULL_BOTTLE)

  cartItems      CartItem[]
  orderItems     OrderItem[]
  boxOptions     CustomBoxOption[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([genderCategory])
  @@index([season])
  @@index([isBestSeller])
  @@index([isNewArrival])
  @@index([fragranceType])
  @@map("products")
}

// A "Custom Tester Box" — customer picks N products from a curated list
model CustomBoxTemplate {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  slotsCount  Int
  price       Decimal             @db.Decimal(10, 2)
  description String?
  isActive    Boolean             @default(true)
  options     CustomBoxOption[]
  cartItems   CartItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("custom_box_templates")
}

model CustomBoxOption {
  id         String            @id @default(cuid())
  templateId String
  template   CustomBoxTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId  String
  product    Product           @relation(fields: [productId], references: [id])

  @@unique([templateId, productId])
  @@map("custom_box_options")
}

model Store {
  id            String   @id @default(cuid())
  branchName    String
  address       String
  city          String
  latitude      Float
  longitude     Float
  googleMapsUrl String
  contactNumber String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("stores")
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?
  user       User?      @relation(fields: [userId], references: [id])
  guestToken String?    @unique
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id                  String             @id @default(cuid())
  cartId              String
  cart                Cart               @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id])
  customBoxTemplateId String?
  customBoxTemplate   CustomBoxTemplate? @relation(fields: [customBoxTemplateId], references: [id])
  customBoxSelections String[]           @default([])
  quantity            Int                @default(1)
  unitPrice           Decimal            @db.Decimal(10, 2)
  createdAt           DateTime           @default(now())

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  trackingId      String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  guestEmail      String?
  guestPhone      String?
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal       @db.Decimal(10, 2)
  shippingFee     Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  city            String
  shippingAddress Json
  voucherCode     String?
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id])
  titleSnapshot       String
  unitPrice           Decimal  @db.Decimal(10, 2)
  quantity            Int
  customBoxSelections String[] @default([])

  @@index([orderId])
  @@map("order_items")
}

model Voucher {
  id             String      @id @default(cuid())
  code           String      @unique
  type           VoucherType
  value          Decimal     @db.Decimal(10, 2)
  minOrderAmount Decimal     @default(0) @db.Decimal(10, 2)
  maxUses        Int?
  usedCount      Int         @default(0)
  isActive       Boolean     @default(true)
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())

  @@map("vouchers")
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  isActive     Boolean  @default(true)
  subscribedAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

model PromotionalBanner {
  id        String    @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  ctaText   String?
  ctaUrl    String?
  position  Int       @default(0)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("promotional_banners")
}

model ShippingRule {
  id              String   @id @default(cuid())
  city            String   @unique
  fee             Decimal  @db.Decimal(10, 2)
  freeThreshold   Decimal? @db.Decimal(10, 2)
  sameDayEligible Boolean  @default(false)

  @@map("shipping_rules")
}
